# Copy this to .env and fill in your actual values.
# Never commit .env to git — secrets only live in environment variables.

# Supabase Postgres connection string (Session pooler)
# Get this from: Supabase project → Connect → Session pooler (not Direct: IPv6-only)
# Format: postgresql://postgres.[ref]:[password]@[host]:5432/postgres
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-1-<region>.pooler.supabase.com:5432/postgres

# Local Postgres for testing (optional, defaults to postgresql:///postgres if unset)
# TEST_DATABASE_URL=postgresql:///postgres

# Claude API key, only needed for analyze.py
# ANTHROPIC_API_KEY=sk-ant-...
